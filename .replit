modules = ["nodejs-20", "web", "bash"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0", "javascript_database:1.0.0", "javascript_object_storage:2.0.0"]
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd zip-repl && PORT=5000 pnpm --filter @workspace/gef-stats run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd zip-repl && PORT=3000 pnpm --filter @workspace/api-server run dev"
waitForPort = 3000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 25343
externalPort = 3001

[[ports]]
localPort = 25344
externalPort = 3003

[userenv]

[userenv.shared]
NODE_ENV = "development"
SUPABASE_URL = "https://vnidzmtmjyoncpvecact.supabase.co"
LOG_LEVEL = "info"
API_PORT = "3000"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd zip-repl && PORT=5000 pnpm --filter @workspace/api-server run start"]
build = ["bash", "-c", "cd zip-repl && BASE_PATH=/ pnpm --filter @workspace/gef-stats run build && pnpm --filter @workspace/api-server run build"]
