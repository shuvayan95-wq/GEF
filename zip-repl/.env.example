# ─── Database ────────────────────────────────────────────────────────────────
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ─── Supabase Storage (image uploads) ────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=<a-long-random-string>

# ─── Email — Gmail SMTP ───────────────────────────────────────────────────────
# Use a Google App Password, NOT your regular Gmail password.
# Enable at: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── AI (optional) ───────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...   # fallback if GROQ_API_KEY is not set

# ─── Admin credentials ────────────────────────────────────────────────────────
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=changeme
