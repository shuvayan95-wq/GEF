modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd zip-repl && PORT=5000 pnpm --filter @workspace/api-server run start"]
build = ["bash", "-c", "cd zip-repl && PORT=5000 BASE_PATH=/ pnpm --filter @workspace/gef-stats run build && pnpm --filter @workspace/api-server run build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VITE_SUPABASE_URL = "https://vnidzmtmjyoncpvecact.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY = "sb_publishable_RICkyWtA8x_m6Wqqeiufcw_e9jBDGgx"
